# Copy to .env locally if you want; Vercel: set these in Project Settings → Environment Variables.

PORT=3000
NODE_ENV=production

# Required on Vercel
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/vspark
MONGODB_DB=vspark
ADMIN_USER=organizer
ADMIN_PASSWORD=change-me
TOKEN_SECRET=long-random-string

# Optional
COMPETITION_MINUTES=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VSPARK <noreply@example.com>"

# Local-only (used when MONGODB_URI is unset)
# DATA_DIR=./data
